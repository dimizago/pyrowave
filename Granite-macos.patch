+	int64_t d = timepoint - get_current_time_nsecs();
 	if (d <= 0)
 		return;
 
 	// Assumes timer resolution has been set.
-	Sleep(d / 1000000);
+	Sleep(static_cast<DWORD>(d / 1000000));
 
 	// Spin the rest of the way.
 	while (get_current_time_nsecs() < timepoint)
@@ -138,14 +174,29 @@ void sleep_until_nsecs(int64_t timepoint)
 		_mm_pause();
 #endif
 	}
+#elif defined(__APPLE__)
+	if (timepoint <= 0)
